# Spotify (required for streaming)
# Create an app at https://developer.spotify.com/dashboard
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id

# Must match a Redirect URI registered in the Spotify Dashboard.
# Local (netlify dev often uses 8888):
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:8888/music/callback
# Production example:
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=https://your-domain.netlify.app/music/callback

# Server-only: enables track titles/art before the user connects (Client Credentials).
# Never expose this to the browser / NEXT_PUBLIC_*.
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Existing admin password for /admin/music
ADMIN_PASSWORD=your_admin_password

# Spotify Dashboard checklist:
# 1. Add redirect URIs for local + production /music/callback
# 2. Enable Web Playback SDK usage (Premium accounts only for in-app playback)
# 3. Redeploy after setting Netlify environment variables
